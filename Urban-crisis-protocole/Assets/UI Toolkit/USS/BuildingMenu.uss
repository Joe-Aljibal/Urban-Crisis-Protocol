/* ================= PALETTE (change colors here only) ================= */
:root {
    --bg-panel:   rgb(45, 45, 48);   /* bar, panels, building list */
    --bg-tile:    rgb(35, 35, 38);   /* cards / buttons inside panels */
    --bg-tile-hv: rgb(58, 58, 64);
    --bg-inset:   rgb(30, 30, 32);
    --border:     rgb(70, 70, 75);
    --divider:    rgb(65, 65, 68);
    --text:       rgb(255, 255, 255);
    --text-muted: rgb(160, 160, 165);
    --danger:     rgb(197, 36, 36);
    --danger-hv:  rgb(225, 55, 55);
    --danger-ac:  rgb(150, 25, 25);
}

/* ================= SHARED ================= */
.panel {
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 14px;
}

.title {
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.val-red    { color: rgb(230, 100, 100); }
.val-blue   { color: rgb(100, 180, 230); }
.val-green  { color: rgb(100, 230, 100); }
.val-orange { color: rgb(255, 170, 90); }
.val-gold   { color: rgb(255, 215, 0); }
.val-cyan   { color: rgb(100, 200, 255); }
.val-purple { color: rgb(150, 150, 255); }
.val-white  { color: rgb(225, 225, 225); }

/* ================= BOTTOM BAR ================= */
.bottom-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    padding: 0 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-panel);
    border-top-width: 1px;
    border-top-color: var(--border);
    z-index: 0;
}

.above-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    flex-direction: column;
    align-items: center;
}

.buildings-scroll {
    width: 750px;
    height: 120px;
    padding: 12px;
    flex-shrink: 0;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
    border-bottom-width: 0;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

/* One tile style shared by stats AND selector buttons */
.bar-tile {
    width: 84px;
    height: 92px;
    margin: 0 4px;
    padding: 6px 4px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-tile);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 12px;
}
.bar-icon {
    height: 28px;
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.bar-label {
    height: 16px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
}

.bar-value {
    height: 20px;
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Left / center / right zones (left & right are equal width = centered middle) */
.stats-container,
.bar-spacer {
    width: 480px;
    flex-shrink: 0;
}

.stats-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.selectors-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Selector buttons */
.selector-btn {
    font-size: 36px;
    color: var(--text);
    -unity-text-align: middle-center;
    padding: 0;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.selector-btn:hover {
    background-color: var(--bg-tile-hv);
    border-color: rgb(120, 120, 130);
    scale: 1.06 1.06;
}

.selector-btn:active {
    background-color: rgb(25, 25, 28);
    scale: 0.96 0.96;
}

/* ================= BUILDING INFO CARD ================= */
.building-info {
    flex-direction: row;
    width: 620px;
    height: 320px;
    padding: 12px;
    margin-bottom: 10px;
    flex-shrink: 0;
    z-index: -1;
}

.model-container {
    width: 296px;
    height: 296px;
    margin-right: 12px;
    background-color: var(--bg-inset);
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.model-placeholder { color: rgb(130, 130, 135); font-size: 14px; }

.details {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
}

.tile-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.info-tile {
    width: 31%;
    height: 90px;
    margin-bottom: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-tile);
    border-radius: 8px;
}

.tile-icon  { font-size: 18px; margin-bottom: 2px; }
.tile-label { color: var(--text-muted);
font-size: 15px; margin-bottom: 1px; }
.tile-value {
    font-size: 13px;
    -unity-font-style: bold;
    color : white;
}

.description-box {
    border-top-width: 1px;
    border-top-color: var(--divider);
    padding-top: 8px;
}

.description {
    color: rgb(170, 170, 175);
    font-size: 11px;
    white-space: normal;
}

/* ================= SELECTED-BUILDING POPUP ================= */
.popup {
    position: absolute;
    right: 2.5%;
    top: 20%;
    width: 320px;
    height: 400px;
    padding: 14px;
    flex-direction: column;
    justify-content: space-between;
}

.popup-top { flex-direction: column; align-items: center; }

.popup-title {
    font-size: 20px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.popup-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.popup-tile {
    width: 47%;
    height: 110px;
    margin-bottom: 10px;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-tile);
    border-radius: 12px;
}

.popup-icon  { font-size: 24px; margin-bottom: 4px; }
.popup-label { color: var(--text-muted); font-size: 11px; margin-bottom: 2px; }
.popup-value { font-size: 15px; -unity-font-style: bold; }

.popup-footer {
    border-top-width: 1px;
    border-top-color: var(--divider);
    padding-top: 10px;
}

.sell-button {
    height: 38px;
    width: 100%;
    margin: 0;
    padding: 0;
    color: var(--text);
    font-size: 14px;
    -unity-font-style: bold;
    background-color: var(--danger);
    border-color: rgb(255, 120, 120);
    border-width: 1px;
    border-radius: 8px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.sell-button:hover  { background-color: var(--danger-hv); }
.sell-button:active { background-color: var(--danger-ac); }