<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/BuildingMenu.uss?fileID=7433441132597879392&amp;guid=3cb5ceb7f3cd2d34d94432acf88269d1&amp;type=3#BuildingMenu"/>
    <ui:VisualElement name="Container" style="flex-grow: 0; background-color: rgb(0, 0, 0); position: absolute; left: auto; right: auto; bottom: 0; top: auto; flex-shrink: 0; align-self: center; aspect-ratio: 16; width: 100%;">
        <ui:ScrollView name="BuildingsContainer" vertical-scroller-visibility="Hidden" mode="Horizontal" focusable="false" touch-scroll-type="Clamped" horizontal-scroller-visibility="Hidden" class="centered-scroll-view" style="bottom: 120px; position: absolute; aspect-ratio: auto; width: 750px; align-self: center; background-color: rgb(0, 0, 0); justify-content: center; align-content: auto; align-items: stretch; flex-shrink: 0; height: 120px; flex-direction: column; border-top-left-radius: 20px; border-top-right-radius: 20px;"/>
        <ui:VisualElement name="SelectorsContainer" style="flex-grow: 1; align-self: center; height: 100%; width: 50%; background-color: rgba(188, 77, 77, 0); flex-direction: row; padding-left: 5%; padding-bottom: initial; padding-right: 5%; padding-top: initial; align-items: center; align-content: auto; justify-content: space-around;">
            <ui:Button text="🏡" name="HousesSelector" enabled="true" style="aspect-ratio: 1; height: 80%; background-color: rgba(188, 188, 188, 0); background-image: none; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 75px;"/>
            <ui:Button text="💵" name="BusinessesSelector" style="aspect-ratio: 1; height: 80%; background-color: rgba(188, 188, 188, 0); background-image: none; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 75px;"/>
            <ui:Button text="🏭" name="IndustriesSelector" style="aspect-ratio: 1; height: 80%; background-color: rgba(188, 188, 188, 0); background-image: none; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 75px;"/>
            <ui:Button text="🍞" name="FoodSelector" style="aspect-ratio: 1; height: 80%; background-color: rgba(188, 188, 188, 0); background-image: none; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 75px;"/>
            <ui:Button text="⚡" name="ElectricitySelector" parse-escape-sequences="false" style="aspect-ratio: 1; height: 80%; background-color: rgba(188, 188, 188, 0); background-image: none; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 75px;"/>
            <ui:Button text="💧" name="WaterSelector" style="aspect-ratio: 1; height: 80%; background-color: rgba(188, 188, 188, 0); background-image: none; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 75px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="StatsContainer" class="stats-container" style="position: absolute; align-items: center; aspect-ratio: 4.55; height: 100%; justify-content: space-between; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-content: auto; align-self: auto; margin-left: 10px;">
            <ui:VisualElement class="stats-column">
                <ui:VisualElement class="stat-card">
                    <ui:Label text="💵" class="stat-icon"/>
                    <ui:Label text=":" class="stat-title"/>
                    <ui:Label name="MoneyValue" text="$X" class="stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:Label text="👥" class="stat-icon"/>
                    <ui:Label text=":" class="stat-title"/>
                    <ui:Label name="PopulationValue" text="x" class="stat-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="stats-column">
                <ui:VisualElement class="stat-card">
                    <ui:Label text="⚡" class="stat-icon"/>
                    <ui:Label text=":" class="stat-title"/>
                    <ui:Label name="ElectricityValue" text="x/x" class="stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:Label text="💧" class="stat-icon"/>
                    <ui:Label text=":" class="stat-title"/>
                    <ui:Label name="WaterValue" text="x/x" class="stat-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="stats-column stats-column-bread">
                <ui:VisualElement class="stat-card">
                    <ui:Label text="🍞" class="stat-icon"/>
                    <ui:Label text=":" class="stat-title"/>
                    <ui:Label name="FoodValue" text="x" class="stat-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
